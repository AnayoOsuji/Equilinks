generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SCHOOL_ADMIN
  EQUILINKS_ADMIN
  SUPER_ADMIN
  EDUCATOR
  SPECIALIST
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  PENDING_INVITE
  INACTIVE
}

enum ParentRelationship {
  MOTHER
  FATHER
  GUARDIAN
  CAREGIVER
}

enum PortalAccess {
  FULL_ACCESS
  READ_ONLY
  INVITED
}

enum SchoolStatus {
  ACTIVE
  REVIEW
  INACTIVE
}

enum EmotionalState {
  SETTLED
  JOYFUL
  ANXIOUS
  OVERWHELMED
  WITHDRAWN
  FRUSTRATED
}

enum IncidentMood {
  CALM
  FOCUSED
  HAPPY
  ANXIOUS
  ELEVATED
  NEED_BREAK
}

enum EnergyLevel {
  LOW
  MODERATE
  HIGH
}

enum ActivityContext {
  MORNING_ARRIVAL
  READING_CIRCLE
  GYM_CLASS
  MATH_STEM
  LUNCH_RECESS
  ART_MUSIC
  BUS_RIDE
}

model School {
  id              String       @id @default(cuid())
  name            String
  code            String?
  type            String?      @default("Inclusive Campus")
  address         String
  email           String
  phone           String
  logo            String?
  leadAdmin       String?
  status          SchoolStatus @default(ACTIVE)
  specializations String[]     @default([])

  users    User[]
  parents  Parent[]
  classes  Class[]
  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schools")
}

model User {
  id         String     @id @default(cuid())
  firstname  String
  surname    String
  email      String     @unique
  password   String?
  avatar     String?
  role       Role       @default(SCHOOL_ADMIN)
  status     UserStatus @default(ACTIVE)
  lastActive DateTime?  @default(now())

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  classes        Class[]            @relation("ClassEducator")
  checkIns       EmotionalCheckIn[] @relation("EducatorCheckIns")
  incidents      Incident[]         @relation("EducatorIncidents")
  homeIncidentReads HomeIncidentRead[]
  studentProfile Student?
  parentProfile  Parent?            @relation("ParentAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Parent {
  id                String             @id @default(cuid())
  firstname         String
  surname           String
  email             String             @unique
  phone             String?
  avatar            String?
  studentName       String // Learner name reference
  relationship      ParentRelationship @default(MOTHER)
  portalAccess      PortalAccess       @default(FULL_ACCESS)
  status            UserStatus         @default(ACTIVE)
  lastCommunication DateTime?          @default(now())
  notes             String?

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  userId String? @unique
  user   User?   @relation("ParentAccount", fields: [userId], references: [id], onDelete: SetNull)

  homeIncidents HomeIncident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parents")
}

model Class {
  id    String  @id @default(cuid())
  name  String
  grade String?

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  educatorId String?
  educator   User?   @relation("ClassEducator", fields: [educatorId], references: [id], onDelete: SetNull)

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("classes")
}

model Student {
  id        String     @id @default(cuid())
  firstname String
  surname   String
  avatar    String?
  status    UserStatus @default(ACTIVE)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  parents       Parent[]
  checkIns      EmotionalCheckIn[]
  incidents     Incident[]
  homeIncidents HomeIncident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@map("students")
}

model EmotionalCheckIn {
  id         String         @id @default(cuid())
  state      EmotionalState
  note       String?
  recordedAt DateTime       @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  educatorId String
  educator   User   @relation("EducatorCheckIns", fields: [educatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([studentId, recordedAt])
  @@index([educatorId])
  @@map("emotional_check_ins")
}

model Incident {
  id         String          @id @default(cuid())
  mood       IncidentMood
  energy     EnergyLevel
  activity   ActivityContext
  recordedAt DateTime        @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  educatorId String
  educator   User   @relation("EducatorIncidents", fields: [educatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([studentId, recordedAt])
  @@index([educatorId])
  @@map("incidents")
}

model HomeIncident {
  id         String       @id @default(cuid())
  mood       IncidentMood
  energy     EnergyLevel?
  note       String?
  occurredAt DateTime     @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Parent? @relation(fields: [parentId], references: [id], onDelete: SetNull)

  reads HomeIncidentRead[]

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@map("home_incidents")
}

model HomeIncidentRead {
  incidentId String
  incident   HomeIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  educatorId String
  educator   User @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@id([incidentId, educatorId])
  @@index([educatorId])
  @@map("home_incident_reads")
}
